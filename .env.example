# LLM Provider: openai | anthropic | google | groq | ollama | deepseek
LLM_PROVIDER=openai

# API keys (the one matching your provider is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Embeddings (RAG only — optional)
# Defaults from LLM_PROVIDER; anthropic/groq/deepseek fall back to openai.
# Supported: openai | google | ollama
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# NOTE: RAG needs an embeddings key. Without it the RAG demo/route is skipped
# and everything else still runs. Set EMBEDDINGS_PROVIDER=ollama to run RAG
# without OPENAI_API_KEY.

# Model override (optional — sensible defaults per provider)
# LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# DeepSeek reasoning mode (optional — "disabled" | "enabled")
# DEEPSEEK_THINKING=disabled

# Server
PORT=3000

# MCP servers config (optional)
# MCP_SERVERS_PATH=./mcp-servers.json

# LangSmith tracing (optional)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langgraph-starter-kit
# LANGCHAIN_TRACING_V2=true

# Production persistence (optional)
# Install: npm install @langchain/langgraph-checkpoint-postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph
