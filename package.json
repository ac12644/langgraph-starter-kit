{
  "name": "langgraph-starter-kit",
  "version": "2.5.2",
  "description": "Production-ready multi-agent starter kit with LangGraph — supports swarm, supervisor, HITL, structured output, and 6 LLM providers",
  "private": true,
  "type": "module",
  "keywords": [
    "langgraph",
    "langchain",
    "multi-agent",
    "ai-agents",
    "swarm",
    "supervisor",
    "mcp",
    "openai",
    "anthropic",
    "ollama",
    "structured-output",
    "human-in-the-loop",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Abhishek Chauhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/ac12644/langgraph-starter-kit"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/server/index.ts",
    "example:rag": "tsx examples/rag-agent/index.ts",
    "example:support": "tsx examples/customer-support/index.ts",
    "example:research": "tsx examples/research-agent/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.18",
    "@langchain/deepseek": "^1.1.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "dotenv": "^17.4.0",
    "fastify": "^5.12.7",
    "langchain": "^1.5.18",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
